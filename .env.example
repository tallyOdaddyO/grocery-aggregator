# RetailScout — copy to .env and fill in. NEVER commit a real .env.

# --- Core ---
APP_ENV=development
LOG_LEVEL=INFO
TARGET_ZIP=33009

# --- Database ---
# Dev/test default (no server required):
DATABASE_URL=sqlite+pysqlite:///./retailscout.db
# Production target:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/retailscout

# --- Redis / workers ---
REDIS_URL=redis://localhost:6379/0

# --- Data source ---
# fixture = read from /fixtures (default, always safe)
# live    = attempt permitted live endpoints (Phase 7 only)
RETAILSCOUT_SOURCE=fixture

# --- Connector policy ---
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_RETRIES=3
PER_RETAILER_RATE_LIMIT_RPS=0.5
USER_AGENT=RetailScout/0.1 (+contact: you@example.com)

# --- Optional retailer credentials (leave blank unless you have legitimate access) ---
WALMART_API_KEY=
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000

# --- Local services (docker-compose.yml, or scripts/services.sh without Docker) ---
# DATABASE_URL=postgresql+psycopg://retailscout:retailscout@localhost:5432/retailscout
# REDIS_URL=redis://localhost:6379/0
# Run the test suite against PostgreSQL instead of SQLite:
# RETAILSCOUT_TEST_DB=postgresql+psycopg://retailscout:retailscout@localhost:5432/retailscout_test
